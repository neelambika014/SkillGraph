# Copy to .env to customise. Everything is optional.

PORT=4000
JWT_SECRET=change-me-in-production

# Use your own MongoDB (local or Atlas). If empty, SkillGraph tries mongodb://127.0.0.1:27017
# and, if nothing is listening there, starts an embedded MongoDB that stores data in ./.mongo-data
MONGO_URI=

# Seed the catalogue + 150 sample candidates automatically on first start
SEED_ON_START=true

# Optional: enables AI-enhanced skill extraction and written career advice (rule-based engine works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
